---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import themeScript from '../scripts/theme.js?raw';
import { getNavigation, type NavigationNode } from '../lib/navigation';
import Terminal from '../components/terminal/Terminal.astro';
import { searchRoute } from '../lib/routes';

interface Props {
  title: string;
  description?: string;
  navigation?: NavigationNode;
}

const {
  title,
  description = 'Akira 的个人博客，记录学习、编程与思考。',
} = Astro.props;
const navigation = Astro.props.navigation ?? await getNavigation();
---

<!doctype html>
<html lang="zh-CN" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a class="skip-link" href="#content">跳转到正文</a>
    <div class="app-shell" data-terminal-disabled="true">
      <div class="workspace">
        <Sidebar root={navigation} />
        <div class="editor">
          <div class="editor-bar" aria-hidden="true"><span>AKIRA'S BLOG</span><span>UTF-8 / Markdown</span></div>
          <main id="content" tabindex="-1"><slot /></main>
        </div>
      </div>
      <Terminal root={navigation} enabled={false} />
      <footer class="status-bar"><a href={searchRoute()}>搜索 / search</a><button type="button" data-terminal-toggle aria-controls="terminal-panel" aria-expanded="false" aria-label="打开终端" disabled>终端 <span aria-hidden="true">Ctrl + `</span></button></footer>
    </div>
  </body>
</html>

<style>
  .app-shell { height: 100dvh; display: grid; grid-template-rows: minmax(0, 1fr) auto auto; }
  .workspace { display: grid; grid-template-columns: 16rem minmax(0, 1fr); min-height: 0; }
  .editor { min-width: 0; overflow-y: auto; }
  .editor-bar { min-height: 2.75rem; display: flex; justify-content: space-between; gap: var(--space-2); padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--border); color: var(--muted); font-size: 0.7rem; letter-spacing: 0.05em; }
  .status-bar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); background: var(--sidebar-bg); border-top: 1px solid var(--border); font-size: 0.75rem; color: var(--muted); }
  .status-bar button { border-color: var(--border); background: transparent; min-height: 2rem; }
  [data-terminal-disabled] #terminal-panel,
  [data-terminal-disabled] [data-terminal-toggle],
  [data-terminal-disabled] [data-terminal-command],
  [data-terminal-disabled] .keyboard-hint,
  [data-terminal-disabled] .terminal-input-hint,
  [data-terminal-disabled] .dashboard noscript { display: none; }
  @media (max-width: 48rem) {
    .app-shell { height: auto; min-height: 100dvh; padding-bottom: 3rem; }
    :global(html[data-terminal-open='true']) .app-shell { padding-bottom: calc(max(10rem, min(45dvh, 24rem)) + 3rem); }
    .workspace { display: block; }
    .editor { overflow: visible; }
    .editor-bar { padding-inline: var(--space-3); }
    .status-bar { position: fixed; inset-inline: 0; bottom: 0; z-index: 21; height: 3rem; }
    .status-bar button { min-height: 2.5rem; }
    .status-bar button span { display: none; }
  }
</style>
