---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dashboard from '../components/dashboard/Dashboard.astro';
import { getPosts } from '../lib/posts';
import { getNavigation } from '../lib/navigation';
const [posts, navigation] = await Promise.all([getPosts(), getNavigation()]);
---

<BaseLayout title="Akira's Blog" navigation={navigation}>
  <Dashboard posts={posts} navigation={navigation} />
</BaseLayout>
