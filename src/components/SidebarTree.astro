---
import type { NavigationNode } from '../lib/navigation-model';
import { containsCurrentRoute } from '../lib/navigation-tree';
import { isCurrentRoute } from '../lib/routes';
import SidebarTree from './SidebarTree.astro';
interface Props { nodes: NavigationNode[]; pathname: string }
const { nodes, pathname } = Astro.props;
const current = (route?: string) => route && isCurrentRoute(pathname, route) ? 'page' as const : undefined;
---
<ul class="tree-children">
  {nodes.map((node) => <li>
    {node.children && node.children.length > 0 ? <details open={containsCurrentRoute(node, pathname)}>
      <summary>{node.name}</summary>
      {node.route && <a class="directory-route" href={node.route} aria-current={current(node.route)}>{node.title}</a>}
      <SidebarTree nodes={node.children} pathname={pathname} />
    </details> : node.route ? <a href={node.route} aria-current={current(node.route)} title={node.title}>{node.type === 'page' ? node.name.replace(/\.md$/, '') : node.name}</a> : <span class="directory">{node.name}</span>}
  </li>)}
</ul>
<style>
  .tree-children {
    inline-size: 100%;
    min-inline-size: 0;
    list-style: none;
    padding: 0 0 0 var(--space-2);
    margin: 0;
    border-left: 1px solid var(--border);
  }
  li, details { min-inline-size: 0; max-inline-size: 100%; }
  a, .directory, summary {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    min-inline-size: 0;
    max-inline-size: 100%;
    padding: var(--space-2);
    color: var(--fg);
    text-decoration: none;
    overflow-wrap: anywhere;
    word-break: break-word;
    white-space: normal;
  }
  summary { cursor: pointer; list-style: none; color: var(--muted); }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '▸'; flex: 0 0 auto; margin-right: var(--space-1); color: var(--muted); }
  details[open] > summary::before { content: '▾'; }
  .directory-route { font-size: var(--text-sm); color: var(--muted); }
  a:hover { background: var(--code-bg); }
  a[aria-current='page'] { background: var(--selection-bg); color: var(--accent); }
  .directory { color: var(--muted); }
</style>
