---
import logo from './logo.txt?raw';
---
<div class="logo" role="img" aria-label="AKIRA'S BLOG">
  <pre class="ascii" aria-hidden="true">{logo.trimEnd()}</pre>
  <p class="compact" aria-hidden="true">[ AKIRA'S BLOG ]</p>
</div>

<style>
  .logo { container-type: inline-size; width: 100%; color: var(--accent); }
  .ascii { font-family: var(--font-mono); font-size: clamp(0.45rem, 1.4vw, 0.82rem); line-height: 1.2; padding: 0; background: transparent; white-space: pre; overflow: visible; letter-spacing: 0; font-variant-ligatures: none; }
  .compact { display: none; font-weight: 700; letter-spacing: 0.05em; font-size: clamp(1rem, 5vw, 1.5rem); }
  @container (max-width: 34rem) { .ascii { display: none; } .compact { display: block; } }
</style>
