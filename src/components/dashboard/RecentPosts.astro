---
import type { getPosts } from '../../lib/posts';
import ContentDate from '../ContentDate.astro';
import { postRoute, postsRoute } from '../../lib/routes';
interface Props { posts: Awaited<ReturnType<typeof getPosts>> }
const { posts } = Astro.props;
---
<section aria-labelledby="recent-heading" class="recent-posts">
  <div class="section-heading"><h2 id="recent-heading">Recent Posts <span>/ 最近文章</span></h2><a href={postsRoute()}>归档 →</a></div>
  <ol>
    {posts.slice(0, 5).map((post, index) => <li>
      <a href={postRoute(post.data.slug)}><span class="index" aria-hidden="true">[{index + 1}]</span><span>{post.data.title}</span></a>
      <ContentDate date={post.data.created} precision={post.data.createdPrecision} />
    </li>)}
  </ol>
  {posts.length === 0 && <p class="muted">还没有公开的文章。</p>}
  <p class="timezone">日期按原文精度显示；具体时间为 UTC+8</p>
</section>
<style>
  .recent-posts { border-block: 1px solid var(--border); padding-block: var(--space-4); }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2); }
  h2 { margin: 0; font-weight: 400; color: var(--accent); }
  h2 span, .section-heading > a { color: var(--muted); font-size: var(--text-sm); }
  ol { list-style: none; padding: 0; margin-block: var(--space-3); }
  li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2) var(--space-3); align-items: baseline; padding-block: var(--space-2); }
  li a { display: flex; align-items: baseline; gap: var(--space-3); text-decoration: none; color: var(--fg); }
  li a:hover { color: var(--accent); text-decoration: underline; }
  .index { color: var(--muted); font-size: var(--text-sm); }
  li :global(time), .timezone { color: var(--muted); font-size: 0.75rem; white-space: nowrap; }
  .timezone { margin: 0; text-align: end; }
  @media (max-width: 64rem) {
    li { grid-template-columns: minmax(0, 1fr); }
    li :global(time) { padding-left: 3.15em; }
  }
</style>
