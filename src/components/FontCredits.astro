import protoLicense from '../../assets/nerd-fonts/0xProto/LICENSE?url';
import nerdCredits from '../../assets/nerd-fonts/0xProto/README.md?url';
---
<details class="font-credits">
  <summary>字体与许可</summary>
  <p>正文：霞鹜文楷 · <a href={wenkaiLicense}>SIL OFL 1.1</a></p>
  <p>等宽文字：0xProto Nerd Font Mono · <a href={protoLicense}>SIL OFL 1.1</a></p>
  <p><a href={nerdCredits}>Nerd Fonts 图标来源与许可说明</a></p>
