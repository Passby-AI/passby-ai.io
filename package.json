{
  "name": "akira-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "sync": "node --experimental-strip-types scripts/sync-obsidian.ts",
    "publish:check": "pnpm sync --strict && pnpm check && pnpm test && pnpm build && pnpm verify:build",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pretest:responsive": "pnpm build",
    "test:responsive": "node scripts/run-responsive-tests.mjs",
    "test:content-build": "node scripts/verify-content-builds.mjs",
    "test:publishing": "node scripts/verify-publishing.mjs",
    "verify:search": "node --experimental-strip-types scripts/verify-search.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "astro": "7.3.2",
    "github-slugger": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "24.10.1",
    "pagefind": "^1.5.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
